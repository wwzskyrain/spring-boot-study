<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>erik.study.spring.boot</groupId>
        <artifactId>spring-boot-study</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>erik.study.spring.boot</groupId>
    <artifactId>spring-boot-xxljob</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 3.x 版 xxl-job-core 要求 Java 17+，本模块单独用 JDK 17 编译（父工程其余模块仍为 Java 8） -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- 覆盖父工程 Spring Boot 2.2.4：本模块需要 Spring Boot 3.x 才能在 Java 17 上运行 -->
        <spring.boot.version>3.5.3</spring.boot.version>
        <!-- 与本地调度中心匹配的 master 版 xxl-job-core（3.5.0-SNAPSHOT，已 mvn install 到本地仓库） -->
        <xxl-job.version>3.5.0-SNAPSHOT</xxl-job.version>
    </properties>

    <!-- 本模块重新导入 Spring Boot 3.x 依赖管理，覆盖从父工程继承的 2.2.4 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot 基础（SpringApplication / IoC，不含 Web 容器；本模块是纯执行器 + API 客户端） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- spring-web：提供 RestTemplate，用于调用调度中心管理 API -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- XXL-JOB 执行器核心 3.x（负责把执行器注册到调度中心、接收调度回调） -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>${xxl-job.version}</version>
        </dependency>

        <!-- JSON 解析（解析调度中心管理 API 的返回结果） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖父工程继承的 spring-boot-maven-plugin 2.2.4，与本模块 Spring Boot 3.x 匹配 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
            </plugin>
        </plugins>
    </build>

</project>
